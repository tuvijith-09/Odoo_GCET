generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  name     String
  role     String @default("STAFF")
}

model Product {
  id           String @id @default(uuid())
  name         String
  sku          String @unique
  category     String
  uom          String
  initialStock Int    @default(0)
  stockQuants  StockQuant[]
  moveHistory  StockMove[]
}

model Location {
  id          String @id @default(uuid())
  name        String
  isWarehouse Boolean @default(false)
  stockQuants StockQuant[]
  movesFrom   StockMove[] @relation("FromLocation")
  movesTo     StockMove[] @relation("ToLocation")
}

model StockQuant {
  id         String @id @default(uuid())
  productId  String
  locationId String
  quantity   Int
  product    Product @relation(fields: [productId], references: [id])
  location   Location @relation(fields: [locationId], references: [id])
  @@unique([productId, locationId])
}

model StockMove {
  id             String @id @default(uuid())
  productId      String
  fromLocationId String?
  toLocationId   String?
  quantity       Int
  documentType   String
  status         String
  date           DateTime @default(now())
  reference      String?
  
  product        Product @relation(fields: [productId], references: [id])
  fromLocation   Location? @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocation     Location? @relation("ToLocation", fields: [toLocationId], references: [id])
}
